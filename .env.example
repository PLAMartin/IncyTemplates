# Application
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_NAME=
APP_ENV=

# Content source: "fixtures" (default when Supabase vars are unset) or "supabase"
CONTENT_SOURCE=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Authenticated admin e2e specs only (tests/e2e/admin-template-editor.spec.ts,
# admin-tool-editor.spec.ts, via tests/e2e/helpers/admin-auth.ts). Must be an email with an
# existing staff (owner/editor) it_profiles row on whichever project NEXT_PUBLIC_SUPABASE_URL
# points at. Unset = those specs skip themselves; never required for `npm run dev`/`build`.
E2E_STAFF_EMAIL=

# Stripe (Phase 3 — not used yet)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Brevo SMTP relay — powers Supabase Auth's transactional email (supabase/config.toml's
# auth.email.smtp), read via env() substitution at `supabase config push` time, not by the
# Next.js app itself. From Brevo's SMTP & API settings, SMTP tab (not the API Keys tab — that
# key is for Brevo's REST API, which GoTrue can't use). See docs/decisions/0059-brevo-smtp.md.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=

# Resend (Phase 2/3 — not used yet)
RESEND_API_KEY=
EMAIL_FROM_ORDERS=
EMAIL_FROM_SUPPORT=
SUPPORT_EMAIL=

# Analytics — GA4 tag only renders when this is set and NODE_ENV=production
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Security and rate limiting (Phase 2+ — not used yet)
RATE_LIMIT_SECRET=
DOWNLOAD_HASH_SECRET=

# Monitoring
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Visual generation (spec v6 §34, server-side admin feature). Defaults to the "test"
# placeholder provider when left unset — see docs/decisions/0050-openai-visual-provider.md.
# Set VISUAL_GENERATION_PROVIDER=openai and OPENAI_API_KEY to enable real OpenAI generation.
VISUAL_GENERATION_ENABLED=
VISUAL_GENERATION_PROVIDER=
VISUAL_GENERATION_MAX_CANDIDATES=
VISUAL_GENERATION_MONTHLY_BUDGET_MINOR=
VISUAL_GENERATION_BUDGET_CURRENCY=
VISUAL_GENERATION_TIMEOUT_MS=
VISUAL_GENERATION_MAX_RETRIES=

# OpenAI visual provider (server-only; never NEXT_PUBLIC_). Not required unless
# VISUAL_GENERATION_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_MODEL_SNAPSHOT=
OPENAI_IMAGE_QUALITY_PROFILE=
OPENAI_IMAGE_OUTPUT_PROFILE=

# scripts/import-abitgamey-assessments.ts only (spec v7 §23.2 source-mapping import) — local
# path to a private ABitGamey checkout. Never read outside that script, never committed to a
# real value, never a runtime dependency of the app.
ABITGAMEY_SOURCE_PATH=

# Business configuration
COMPANY_LEGAL_NAME=
COMPANY_NUMBER=
COMPANY_REGISTERED_ADDRESS=
DEFAULT_CURRENCY=
